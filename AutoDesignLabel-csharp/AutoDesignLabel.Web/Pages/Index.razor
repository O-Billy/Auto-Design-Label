    private static string ConfClass(ContentField f) =>
        string.IsNullOrWhiteSpace(f.SampleValue) ? "empty"
        : f.Confidence >= 0.9f ? "high"
        : f.Confidence >= 0.5f ? "mid" : "low";

    private static string ConfTitle(ContentField f) => ConfClass(f) switch
    {
        "high" => $"Chắc chắn ({f.Source}) — kiểm tra nhanh",
        "mid"  => $"Khá chắc ({f.Source}) — nên xác nhận",
        "low"  => $"Độ tin cậy thấp ({f.Source}) — PHẢI xác nhận",
        _      => "Chưa có giá trị — điền vào hoặc để trống nếu lấy từ data feed",
    };

    private void UpdateSample(string token, string? value)
    {
        _sampleData[token] = value ?? "";
        if (_doc is not null && _doc.Fields.TryGetValue(token, out var fd)) fd.Sample = value ?? "";
        RenderAllLabels();
        _pdfDataUrl = _selectedLabelId is not null
            ? _labelRenderCache.GetValueOrDefault(_selectedLabelId)?.PdfDataUrl : null;
    }

    // Render truoc PDF + lint cho TOAN BO nhan co the in (khong chi nhan dang chon) ngay sau khi
    // trich xuat xong - de tab "Kiem tra in an" va cac pill canh bao tren the nhan hien dung tong
    // quan toan tai lieu (giong buoc "2. Tu dong thiet ke" da hoan tat), thay vi phai bam qua tung
    // nhan moi biet co canh bao hay khong.
    private void RenderAllLabels()
    {
        _labelRenderCache.Clear();
        foreach (var label in PrintableLabels)
        {
            if (label.Elements.Count == 0)
            {
                _labelRenderCache[label.Id] = new LabelRender(null, new(), "manual layout needed.");
                continue;
            }
            try
            {
                var lint = new Linter();
                using var pdfStream = new MemoryStream();
                new PdfLabelRenderer(lint).RenderLabel(label, _sampleData, pdfStream);
                var url = "data:application/pdf;base64," + Convert.ToBase64String(pdfStream.ToArray());
                _labelRenderCache[label.Id] = new LabelRender(url, lint.Rows.ToList(), null);
            }
            catch (Exception ex)
            {
                _labelRenderCache[label.Id] = new LabelRender(null, new(), ex.Message);
            }
        }
    }

    // Chay 1 tac vu bat dong bo trong khi hien popup loading giua man hinh voi % tang dan muot.
    // Dung chung cho moi tien trinh: cac tien trinh backend hien khong co moc tien do con de bao %
    // that (PmdExtractor.Extract / LabFileGenerator.Generate deu la 1 loi goi kho chia nho), nen %
    // hien thi la uoc luong easing toi da 89% trong luc cho, roi chot 100% ngay khi work() xong -
    // dung UX pattern chuan cho tac vu khong do duoc tien do chi tiet (giong thanh loading cua
    // nhieu trinh duyet/ung dung).
    private async Task RunWithProgress(string label, Func<Task> work)
    {
        _loadingLabel = label;
        _loadingPercent = 0;
        _loadingVisible = true;
        StateHasChanged();

        using var cts = new CancellationTokenSource();
        var progressLoop = SimulateProgressAsync(cts.Token);

        try
        {
            await work();
        }
        finally
        {
            cts.Cancel();
            try { await progressLoop; } catch (OperationCanceledException) { }

            _loadingPercent = 100;
            StateHasChanged();
            await Task.Delay(350);
            _loadingVisible = false;
            StateHasChanged();
        }
    }

    private async Task SimulateProgressAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(120, token);
                _loadingPercent += Math.Max(1, (89 - _loadingPercent) / 8);
                if (_loadingPercent > 89) _loadingPercent = 89;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { /* huy binh thuong khi work() da xong */ }
    }

    private void SelectLabel(string? labelId)
    {
        _selectedLabelId = labelId;
        _errorMessage = null;
        _labExportError = null;
        _zplExportError = null;
        _zoomPercent = 100;

        var render = labelId is not null ? _labelRenderCache.GetValueOrDefault(labelId) : null;
        _pdfDataUrl = render?.PdfDataUrl;
    }

    private async Task ExportLab()
    {
        if (_doc is null || _selectedLabel is null) return;

        _labExportError = null;
        var label = _selectedLabel;
        var doc = _doc;
        var sampleData = _sampleData;

        await RunWithProgress("Exporting .lab file (CodeSoft 6)...", async () =>
        {
            try
            {
                var tempPath = Path.ChangeExtension(Path.GetTempFileName(), ".lab");

                var result = await Task.Run(() =>
                    new LabFileGenerator().Generate(label, doc, sampleData, tempPath));

                if (!result.Success)
                {
                    _labExportError = $"Could not export .lab: {result.ErrorMessage}";
                    return;
                }

                var token = Guid.NewGuid().ToString("N");
                FileDownloads.Pending[token] = new FileDownloads.Entry(tempPath, $"{label.Id}.lab");
                Nav.NavigateTo($"{Nav.BaseUri}download-file/{token}", forceLoad: true); // BaseUri gom san path base (IIS sub-app)
            }
            catch (Exception ex)
            {
                _labExportError = $"Could not export .lab: {ex.Message}";
            }
        });
    }

    private async Task ExportZpl()
    {
        if (_doc is null || _selectedLabel is null) return;

        _zplExportError = null;
        var label = _selectedLabel;
        var sampleData = _sampleData;

        await RunWithProgress("Exporting ZPL file...", async () =>
        {
            try
            {
                var zpl = await Task.Run(() => new ZplEmitter(203).EmitStoredFormat(label, sampleData));
                var tempPath = Path.ChangeExtension(Path.GetTempFileName(), ".zpl");
                await File.WriteAllTextAsync(tempPath, zpl);

                var token = Guid.NewGuid().ToString("N");
                FileDownloads.Pending[token] = new FileDownloads.Entry(tempPath, $"{label.Id}.zpl");
                Nav.NavigateTo($"{Nav.BaseUri}download-file/{token}", forceLoad: true); // BaseUri gom san path base (IIS sub-app)
            }
            catch (Exception ex)
            {
                _zplExportError = $"Could not export ZPL: {ex.Message}";
            }
        });
    }
